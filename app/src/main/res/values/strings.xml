    <string name="about_changes_title">Key changes</string>
    <string name="about_change_rebrand">• Rebranded as Vibe with refreshed app icon and green visual theme.</string>
    <string name="about_change_vgm_removed">• Removed all VGM support.</string>
    <string name="about_change_library_incremental">• Added cache-first library loading with incremental refresh behavior.</string>
    <string name="about_change_large_library">• Optimized large-library scanning/indexing for speed and reliability.</string>
    <string name="about_change_smart_shuffle">• Added smarter anti-repeat shuffle behavior using playback history.</string>
    <string name="about_change_playlist_import">• Improved playlist import matching across mixed formats and path styles.</string>
    <string name="about_change_playlist_edit_reliability">• Improved playlist edit reliability with draft persistence and explicit save/discard flow.</string>
    <string name="about_change_playlist_controls">• Added playlist controls for add-to-top preference and icon-based Play/Shuffle actions.</string>
    <string name="about_change_playlist_enhancements">• Kept empty custom playlists and enabled adding selected tracks to multiple playlists at once.</string>
    <string name="about_change_format_albums">• Separated album groups by audio file format, with a format badge on each album.</string>
    <string name="about_change_track_info_metadata">• Added track file info and manual metadata editing from the now-playing menu.</string>
    <string name="about_change_lyrics_control">• Expanded lyrics controls with local download, source visibility, and clearer selection status.</string>
    <string name="about_change_lyrics_manager">• Added lyric-file import and playlist lyric management with five searchable candidates per track; existing local lyrics are preserved during batch downloads.</string>
